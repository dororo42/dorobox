<?xml version="1.0" encoding="utf-8"?>
<!-- 自动搜索数据源对话框：种子页发现候选配置，勾选批量加入接口历史 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vs_530"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:padding="@dimen/vs_20">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="自动搜索数据源"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:layout_width="@dimen/vs_600"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:text="扫描内置种子页发现公开的配置地址，勾选后一键加入接口历史。搜索全程约 30 秒。"
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_20" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="@dimen/vs_600"
            android:layout_height="@dimen/vs_280"
            android:layout_marginTop="@dimen/vs_10" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="@dimen/vs_600"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_5"
            android:text=""
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_18" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="搜索"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/btnAddSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="添加所选"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="关闭"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
