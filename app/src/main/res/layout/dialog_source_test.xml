<?xml version="1.0" encoding="utf-8"?>
<!-- 一键验证源对话框：批量测试接口历史里的配置地址连通性 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/vs_20"
    android:background="@drawable/shape_dialog_bg_main"
    android:orientation="vertical"
    android:padding="@dimen/vs_20">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="测试源连通性"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_26" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:text="逐条测试接口历史中的配置地址：HTTP 状态 · 耗时 · 站点数。最多测最近 10 条，3 路并发。"
        android:textColor="@color/color_FFFFFF_70"
        android:textSize="@dimen/ts_20" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_600"
        android:layout_marginTop="@dimen/vs_10" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_5"
        android:textColor="@color/color_FFFFFF_70"
        android:textSize="@dimen/ts_18" />

    <TextView
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:background="@drawable/button_dialog_main"
        android:focusable="true"
        android:gravity="center"
        android:padding="@dimen/vs_10"
        android:text="关闭"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22" />
</LinearLayout>
