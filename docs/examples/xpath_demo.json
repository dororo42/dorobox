{
  "_comment": "XPath 声明式源示例。app 本体不含解析类，需搭配捆绑了 csp_XPath 的社区 jar 使用。",
  "_usage": "站点项写 type:3, api:'csp_XPath', ext:<本文件内容或其URL>",
  "homeUrl": "https://demo.example.com",
  "cateManual": {
    "电影": "1",
    "剧集": "2"
  },
  "homeVodNode": "//div[@class='module-item']",
  "homeVodName": "//div[@class='module-item-title']//text()",
  "homeVodId": "//a/@href",
  "homeVodIdR": "/detail/(\\w+).html",
  "homeVodImg": "//img/@data-src",
  "homeVodMark": "//div[@class='module-item-note']//text()",
  "cateUrl": "https://demo.example.com/type/{cateId}-{catePg}.html",
  "cateVodNode": "//div[@class='module-item']",
  "cateVodName": "//div[@class='module-item-title']//text()",
  "cateVodId": "//a/@href",
  "cateVodIdR": "/detail/(\\w+).html",
  "cateVodImg": "//img/@data-src",
  "dtUrl": "https://demo.example.com/detail/{vid}.html",
  "dtNodeName": "//h1[@class='page-title']//text()",
  "dtNodeDesc": "//div[@class='module-info-introduction-content']//text()",
  "dtNodeImg": "//div[@class='module-info-poster']//img/@data-src",
  "dtFromNode": "//div[@class='module-tab-item']",
  "dtFromName": "/@alt",
  "dtUrlNode": "//div[@class='module-play-list']",
  "dtUrlSubNode": "//a",
  "dtUrlId": "/@href",
  "dtUrlIdR": "/play/(\\w+)-(\\d+)-(\\d+).html",
  "dtUrlName": "/span/text()",
  "playUrl": "https://demo.example.com/play/{vid}-{ep}-{n}.html",
  "playParse": 1
}
